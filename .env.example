# ── FRONTEND (public — safe to be embedded in the browser bundle) ────────────
# Vite inlines VITE_* at BUILD time. Changing them in Vercel requires a new
# deployment; they are not read at runtime by the server.
# `REACT_APP_*` names are still accepted as a legacy fallback (vite.config.js
# maps them into the same values); use one naming scheme, not both.
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Analytics is
# disabled entirely when this is left empty.
VITE_GA_ID=

# ── SERVER-SIDE ONLY (Vercel Project / Function environment — NEVER in .env) ─
# These power the secure /api/* serverless functions and must NEVER be shipped
# to the browser (do not prefix them with VITE_).
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SESSION_SECRET=generate_a_long_random_string
TELEGRAM_BOT_TOKEN=your_rotated_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Bark (iOS) push channel. Create the key in the Bark app. The key is server-only:
# never expose it to the browser, an API response, or a log line.
BARK_DEVICE_KEY=your_bark_device_key_here
# Optional: comma-separated allowed browser origins (defaults to the prod + localhost)
ALLOWED_ORIGINS=https://za-shm.vercel.app,http://localhost:3000
# Optional: tracking-link origin and sitemap canonical origin (must be the production domain)
PUBLIC_BASE_URL=https://za-shm.vercel.app

# ── OPTIONAL: SHARED RATE LIMITING ───────────────────────────────────────────
# Upstash is used when configured. Otherwise the server uses the
# `supabase/rate_limit_storage.sql` RPC, which must be applied manually before
# deploying the matching API code. Until either shared provider is available,
# the runtime can only fall back to per-instance counters.
# Never expose the token to the browser or prefix it with VITE_.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── ORDER-TRACKING LINKS ─────────────────────────────────────────────────────
# New links expire after 720 hours (30 days) by default. Set a positive number
# to override the lifetime. Already-sent legacy links keep working.
# Note: rotating SESSION_SECRET invalidates ALL tracking links.
TRACKING_TOKEN_TTL_HOURS=720