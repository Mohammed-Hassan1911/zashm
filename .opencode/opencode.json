{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": ".env*",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": ".env*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "build/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "node_modules/**",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git commit*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git push*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "vercel deploy*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "vercel --prod*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "vercel env *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "supabase db push*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "supabase projects *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "psql *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "rm -rf *",
      "effect": "ask"
    }
  ]
}
